{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cap://schemas/gate-decision.schema.json",
  "title": "Gate decision",
  "type": "object",
  "required": [
    "version",
    "run_id",
    "decision",
    "reason_codes",
    "policy_version",
    "created_at",
    "details"
  ],
  "properties": {
    "version": { "const": 1 },
    "run_id": { "type": "string" },
    "decision": { "enum": ["PASS", "FAIL", "HUMAN"] },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "policy_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "details": { "type": "object" }
  },
  "additionalProperties": true
}
