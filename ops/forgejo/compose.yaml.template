services:
  forgejo:
    image: __FORGEJO_IMAGE__
    container_name: forgejo
    user: "1000:1000"
    restart: unless-stopped
    environment:
      USER_UID: "1000"
      USER_GID: "1000"
      FORGEJO_WORK_DIR: /var/lib/gitea
      FORGEJO_CUSTOM: /var/lib/gitea/custom
      FORGEJO__server__ROOT_URL: http://192.168.31.9:3000/
      FORGEJO__server__DOMAIN: 192.168.31.9
      FORGEJO__server__HTTP_PORT: "3000"
      FORGEJO__server__SSH_DOMAIN: 192.168.31.9
      FORGEJO__server__SSH_PORT: "2222"
      FORGEJO__server__START_SSH_SERVER: "true"
      FORGEJO__server__SSH_LISTEN_PORT: "2222"
      FORGEJO__database__DB_TYPE: sqlite3
      FORGEJO__database__PATH: /var/lib/gitea/data/forgejo.db
      FORGEJO__database__SQLITE_JOURNAL_MODE: WAL
      FORGEJO__service__DISABLE_REGISTRATION: "true"
      FORGEJO__service__SHOW_REGISTRATION_BUTTON: "false"
      FORGEJO__service__REQUIRE_SIGNIN_VIEW: "true"
      FORGEJO__actions__ENABLED: "false"
      FORGEJO__repository__ENABLE_PUSH_CREATE_USER: "false"
      FORGEJO__repository__ENABLE_PUSH_CREATE_ORG: "false"
      FORGEJO__mirror__ENABLED: "false"
      FORGEJO__packages__ENABLED: "false"
      FORGEJO__metrics__ENABLED: "false"
      FORGEJO__api__ENABLE_SWAGGER: "false"
      FORGEJO__log__MODE: console
      FORGEJO__log__LEVEL: Info
    ports:
      - "3000:3000"
      - "2222:2222"
    volumes:
      - ./data:/var/lib/gitea
      - /etc/localtime:/etc/localtime:ro
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:3000/api/healthz"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
